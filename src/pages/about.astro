---
import Collapser from "../components/Collapser.tsx";
import BentoTile from "../components/BentoTile";
import NavigationBar from "../components/NavigationBar";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import type React from "react";
import ProductCollapsers from "../components/ProductCollapsers";
import ActionButton from "../components/ActionButton";
import { FeatureBlock } from "../components/FeatureBlock";
import { AnimatedStat } from "../components/AnimatedStat";
import { Timeline } from "../components/TimelineStep";
import { LogoMarquee } from "../components/LogoMarquee";
---

<Layout>
  <NavigationBar client:load />

  <div class="w-full flex flex-col justify-start items-center min-h-screen">
    <div
      class="max-w-6xl mx-auto mt-10 md:mt-20 space-y-10 md:space-y-20 px-6 md:px-0"
    >
      <!-- Hero -->
      <h1 class="text-3xl md:text-5xl text-black font-bold mb-4">About Us</h1>
      <p class="text-lg md:text-xl text-black leading-relaxed">
        Elliott Promotional Products is a Canadian, family-owned business based
        in Stratford, ON. Since 1998, Ivan Elliott has been helping
        organizations of all sizes bring their brand to life—on time, on budget,
        and with a personal touch.
      </p>

      <!-- Stats -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 md:mt-32">
        <AnimatedStat client:load end={27} label="Years Strong" />
        <AnimatedStat client:load end={200} label="Clients Served" />
        <AnimatedStat client:load end={1000} label="Orders Completed" />
      </div>

      <!-- Timeline -->
      <!-- <Timeline
        steps={[
          { year: "1998", title: "Founded by Ivan & Mary Elliott" },
          { year: "1999", title: "First major golf-ball order" },
          { year: "2000", title: "Warner Bros. license" },
        ]}
      /> -->

      <!-- Values -->
      <div class="grid grid-cols-1 md:grid-cols-3 md:gap-8">
        <FeatureBlock bg="#F3F4F6" client:visible>
          <h3 class="font-semibold text-2xl mb-2">Our Mission</h3>
          <p>
            To amplify <strong>your</strong> brand with creative, budget-friendly
            merchandise and white-glove service.
          </p>
        </FeatureBlock>

        <FeatureBlock bg="#F3F4F6" client:visible>
          <h3 class="font-semibold text-2xl mb-2">Our Guarantee</h3>
          <p>
            Perfection or we redo it. Delivery on or before the promised date,
            guaranteed.
          </p>
        </FeatureBlock>

        <FeatureBlock bg="#F3F4F6" client:visible>
          <h3 class="font-semibold text-2xl mb-2">Canadian Pride</h3>
          <p>
            Proudly Canadian, family-run, and committed to sourcing locally when
            we can.
          </p>
        </FeatureBlock>
      </div>

      <!-- Client Logos -->
      <LogoMarquee
        logos={[
          "/images/toyota_logo.png",
          "/images/jellystone_logo.png",
          "/images/national_ballet.jpg",
          "/images/stratford_festival_logo.png",
          "/images/elliott_motors_logo.png",
        ]}
      />

      <!-- CTA -->
      <div class="text-center">
        <a
          href="/contact"
          class="px-8 py-4 text-lg bg-red-800 hover:bg-red-700 rounded-lg text-white font-bold"
          >Request a Quote</a
        >
      </div>
    </div>
  </div>
  <div
    class="w-full mt-10 md:mt-20 flex flex-col justify-center items-center bg-black"
  >
    <div
      class="w-full px-4 md:px-0 md:w-auto py-6 text-white text-sm md:text-md tracking-wide flex flex-col justify-center md:flex-row space-y-1 md:space-y-0 items-start md:items-center md:space-x-2"
    >
      <p>Elliott Promotional Products</p>
      <p class="hidden md:block">•</p>
      <p>Stratford, ON</p>

      <p class="hidden md:block">•</p>
      <p>
        <a href="mailto:owner@elliottpromotional.ca" class="underline"
          >owner@elliottpromotional.ca</a
        >
      </p>
    </div>
    <div
      class="w-full max-w-6xl flex flex-col md:flex-row justify-center items-center md:space-x-20"
    >
      <img
        src="/images/white-logo.png"
        alt="elliott promotional products"
        class="w-48 md:w-64"
      />

      <div
        class="w-full flex flex-row justify-center items-center space-x-12 md:space-x-20"
      >
        <div
          class="flex flex-col justify-center items-start text-white space-y-1 md:space-y-4"
        >
          <h2 class="text-white font-bold text-lg md:text-xl md:py-2">Legal</h2>
          <a href="/terms-of-use" class="hover:underline">Terms of use</a>
          <a href="/privacy-policy" class="hover:underline">Privacy policy</a>
          <a href="/cookie-policy" class="hover:underline">Cookie policy</a>
        </div>
        <div
          class="flex flex-col justify-center items-start text-white space-y-1 md:space-y-4"
        >
          <h2 class="text-white font-bold text-lg md:text-xl md:py-2">
            Support
          </h2>
          <a href="/contact" class="hover:underline">Contact us</a>
          <a href="mailto:owner@elliottpromotional.ca" class="hover:underline"
            >Send an email</a
          >
          <a href="/contact" class="hover:underline">Request a quote</a>
        </div>
      </div>
    </div>
    <p class="text-white mt-6 mb-16">Copyright 2025 &copy;</p>
  </div>
</Layout>
