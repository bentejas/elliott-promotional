---
import NavigationBar from "../components/NavigationBar";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import BentoTile from "../components/BentoTile";
import ClientSections from "../components/ClientSections";
import FAQSection from "../components/FAQ";
---

<Layout>
  <NavigationBar client:load />

  <div class="w-full flex flex-col justify-center items-center">
    <div
      class="w-full px-0 md:px-48 flex flex-col-reverse md:flex-row justify-end mt-8 md:mt-0 items-center md:-translate-x-20 md:min-h-screen"
    >
      <img
        src="/images/ElliottHeroImageRed.webp"
        alt="model with elliott promotional merchanise on"
        class="md:w-1/2"
      />
      <div
        class="flex flex-col justify-center items-start w-full md:max-w-2xl px-4 md:px-0 space-y-6 md:-translate-y-32"
      >
        <h1
          class="text-4xl tracking-wide md:text-5xl leading-12 md:leading-16 md:tracking-wide"
        >
          Your Trusted Partner in Promotional Products for Over 25 Years
        </h1>
        <a
          href="/products"
          class="px-6 py-4 rounded-xl bg-red-800 text-white font-bold text-lg hover:bg-red-700"
          >Browse Products</a
        >
      </div>
    </div>

    <!-- Featured Product Categories section -->
    <div
      class="w-full px-6 md:max-w-6xl mx-auto flex flex-col justify-center items-start space-y-4 md:space-y-8 mt-12 md:mt-0"
    >
      <h2 class="font-bold text-3xl md:text-5xl">
        Featured Product Categories
      </h2>

      <p class="text-lg md:text-2xl">
        These are the main products we brand, but we can do a lot more. <a
          href="/contact"
          class="underline"></a>Contact us if there is something you don't see.
      </p>

      {/* Mobile (3-col) */}
      <div class="grid grid-cols-3 gap-2 w-full md:hidden">
        {/* Row 1–2, Col 1–2: Apparel (2×2) */}
        <BentoTile
          tileTitle="Apparel"
          href="/products#apparel"
          tileSize="big"
          className="col-span-2 row-span-2 aspect-square"
        />

        {/* Row 1, Col 3: Bags */}
        <BentoTile
          tileTitle="Bags"
          href="/products#bags"
          tileSize="small"
          className="aspect-square"
        />

        {/* Row 2, Col 3: Office */}
        <BentoTile
          tileTitle="Office"
          href="/products#office"
          tileSize="small"
          className="aspect-square row-start-2 col-start-3"
        />

        {/* Row 3, Col 1: Fun Items (1×1) */}
        <BentoTile
          tileTitle="Fun Items"
          href="/products#fun-items"
          tileSize="small"
          className="aspect-square row-start-3 col-start-1"
        />

        {/* Row 3, Col 2-3: Athletic Wear (1×2) */}
        <BentoTile
          tileTitle="Athletic Wear"
          href="/products#athletic-wear"
          tileSize="small"
          className="row-start-3 col-start-2 col-span-2 aspect-[2/1]"
        />

        {/* Row 4, Col 1-2: Leisure Items (1×2) */}
        <BentoTile
          tileTitle="Leisure Items"
          href="/products#leisure-items"
          tileSize="small"
          className="row-start-4 col-start-1 col-span-2 aspect-[2/1]"
        />

        {/* Row 4, Col 3: HI VIS */}
        <BentoTile
          tileTitle="HI VIS"
          href="/products#hivis"
          tileSize="small"
          className="aspect-square row-start-4 col-start-3"
        />

        {/* Row 5, Col 1: Hats */}
        <BentoTile
          tileTitle="Hats"
          href="/products#hats"
          tileSize="small"
          className="aspect-square row-start-5 col-start-1"
        />

        {/* Row 5-6, Col 2-3: Drinkware (2×2) */}
        <BentoTile
          tileTitle="Drinkware"
          href="/products#drinkware"
          tileSize="big"
          className="row-start-5 col-start-2 col-span-2 row-span-2 aspect-square"
        />

        {/* Row 6, Col 1: Full Catalog */}
        <BentoTile
          tileTitle="Full Catalog"
          href="/products#full-catalog"
          tileSize="small"
          className="aspect-square row-start-6 col-start-1"
        />
      </div>

      {/* Desktop (6-col) */}
      <div class="hidden md:grid grid-flow-row-dense grid-cols-6 gap-2 w-full">
        <BentoTile
          tileTitle="Apparel"
          href="/products#apparel"
          tileSize="big"
          className="col-span-2 row-span-2 aspect-square"
        />
        <BentoTile
          tileTitle="Bags"
          href="/products#bags"
          tileSize="small"
          className="aspect-square"
        />
        <BentoTile
          tileTitle="Office"
          href="/products#office"
          tileSize="small"
          className="aspect-square"
        />
        <BentoTile
          tileTitle="Athletic Wear"
          href="/products#athletic-wear"
          tileSize="small"
          className="col-span-2 aspect-[2/1]"
        />
        <BentoTile
          tileTitle="Drinkware"
          href="/products#drinkware"
          tileSize="big"
          className="col-span-2 row-span-2 aspect-square"
        />
        <BentoTile
          tileTitle="Fun Items"
          href="/products#fun-items"
          tileSize="small"
          className="aspect-square"
        />
        <BentoTile
          tileTitle="HI VIS"
          href="/products#hivis"
          tileSize="small"
          className="aspect-square"
        />
        <BentoTile
          tileTitle="Leisure Items"
          href="/products#leisure-items"
          tileSize="small"
          className="col-span-2 aspect-[2/1]"
        />
        <BentoTile
          tileTitle="Hats"
          href="/products#hats"
          tileSize="small"
          className="aspect-square"
        />
        <BentoTile
          tileTitle="Full Catalog"
          href="/products#full-catalog"
          tileSize="small"
          className="aspect-square"
        />
      </div>
    </div>

    <!-- Testimonials / Previous Clients section -->

    <div
      class="w-full bg-zinc-100 mt-12 md:mt-32 flex justify-center items-center pb-10"
    >
      <div
        class="w-full md:max-w-6xl px-6 md:px-0 mx-auto flex flex-col justify-center items-center"
      >
        <h3
          class="text-2xl md:text-4xl text-left text-black w-full mt-10 md:mt-20"
        >
          Elliott Promotional Products is located in the London-Kitchener area,
          providing quality promotional merchandise for 28 years.
        </h3>
        <p class="text-sm text-black text-left w-full mt-6">
          Here are the types of businesses we've helped over the years...
        </p>

        <h2 class="text-3xl md:text-5xl w-full text-left mt-6 font-bold">
          Clients
        </h2>
        <ClientSections client:load />
      </div>
    </div>

    <!-- Frequently asked questions section -->
    <div class="w-full my-10 md:my-20 flex justify-center items-center">
      <div
        class="w-full max-w-6xl flex flex-col justify-center items-center px-6 md:px-0"
      >
        <h2
          class="text-3xl md:text-5xl font-bold w-full text-left mb-2 md:mb-6"
        >
          Frequently Asked Questions
        </h2>
        <FAQSection client:load />
      </div>
    </div>

    <div
      class="w-full mt-10 md:mt-20 flex flex-col justify-center items-center bg-black"
    >
      <div
        class="w-full px-4 md:px-0 md:w-auto py-6 text-white text-sm md:text-md tracking-wide flex flex-col justify-center md:flex-row space-y-1 md:space-y-0 items-start md:items-center md:space-x-2"
      >
        <p>Elliott Promotional Products</p>
        <p class="hidden md:block">•</p>
        <p>Stratford, ON</p>

        <p class="hidden md:block">•</p>
        <p>
          <a href="mailto:owner@elliottpromotional.ca" class="underline"
            >owner@elliottpromotional.ca</a
          >
        </p>
      </div>
      <div
        class="w-full max-w-6xl flex flex-col md:flex-row justify-center items-center md:space-x-20"
      >
        <img
          src="/images/white-logo.png"
          alt="elliott promotional products"
          class="w-48 md:w-64"
        />

        <div
          class="w-full flex flex-row justify-center items-center space-x-12 md:space-x-20"
        >
          <div
            class="flex flex-col justify-center items-start text-white space-y-1 md:space-y-4"
          >
            <h2 class="text-white font-bold text-lg md:text-xl md:py-2">
              Legal
            </h2>
            <a href="/terms-of-use" class="hover:underline">Terms of use</a>
            <a href="/privacy-policy" class="hover:underline">Privacy policy</a>
            <a href="/cookie-policy" class="hover:underline">Cookie policy</a>
          </div>
          <div
            class="flex flex-col justify-center items-start text-white space-y-1 md:space-y-4"
          >
            <h2 class="text-white font-bold text-lg md:text-xl md:py-2">
              Support
            </h2>
            <a href="/contact" class="hover:underline">Contact us</a>
            <a href="mailto:owner@elliottpromotional.ca" class="hover:underline"
              >Send an email</a
            >
            <a href="/contact" class="hover:underline">Request a quote</a>
          </div>
        </div>
      </div>
      <p class="text-white mt-6 mb-16">Copyright 2025 &copy;</p>
    </div>
  </div>
</Layout>
