---
import NavigationBar from "../components/NavigationBar";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import BentoTile from "../components/BentoTile";
import ClientSections from "../components/ClientSections";
import FAQSection from "../components/FAQ";
---

<Layout>
  <NavigationBar />

  <div class="w-full flex flex-col justify-center items-center">
    <div
      class="w-full px-48 flex flex-row justify-center items-center -translate-x-20 min-h-screen"
    >
      <img
        src="/images/ElliottHeroImage.webp"
        alt="model with elliott promotional merchanise on"
        class="w-1/2"
      />
      <div
        class="flex flex-col justify-center items-start w-full max-w-2xl space-y-6 -translate-y-32"
      >
        <h1 class="text-5xl leading-16 tracking-wide">
          Your Trusted Partner in Promotional Products for Over 25 Years
        </h1>
        <a
          href="/products"
          class="px-6 py-4 rounded-xl bg-red-800 text-white font-bold text-lg hover:bg-red-700"
          >Browse Products</a
        >
      </div>
    </div>

    <!-- Featured Product Categories section -->
    <div
      class="w-full max-w-6xl flex flex-col justify-center items-start space-y-8"
    >
      <h2 class="font-bold text-5xl">Featured Product Categories</h2>

      <p class="text-2xl">
        These are the main products we brand, but we can do a lot more. <a
          href="/contact"
          class="underline"></a>Contact us if there is something you don't see.
      </p>

      <div class="grid grid-flow-row-dense grid-cols-6 gap-2 w-full">
        <!-- Top-left: Apparel (2 col x 2 row, square) -->
        <BentoTile
          className="col-span-2 row-span-2 aspect-square"
          tileTitle="Apparel"
          href="/products"
          tileSize="big"
          onClick={() => (window.location.href = "/products")}
        />

        <!-- Top row: Bags (1x1), Something (1x1), Athletic Wear (2x1) -->
        <BentoTile
          className="col-span-1 row-span-1 aspect-square"
          tileTitle="Bags"
          href="/products"
          tileSize="small"
          onClick={() => (window.location.href = "/products")}
        />
        <BentoTile
          className="col-span-1 row-span-1 aspect-square"
          tileTitle="Office"
          href="/products"
          tileSize="small"
          onClick={() => (window.location.href = "/products")}
        />
        <BentoTile
          className="col-span-2 row-span-1"
          tileTitle="Athletic Wear"
          href="/products"
          tileSize="small"
          onClick={() => (window.location.href = "/products")}
        />

        <!-- Drinkware (2 col x 2 row, square) -->
        <BentoTile
          className="col-span-2 row-span-2 aspect-square"
          tileTitle="Drinkware"
          href="/products"
          tileSize="big"
          onClick={() => (window.location.href = "/products")}
        />

        <!-- Top two squares in bottom-right block (row 2, cols 5-6) -->
        <BentoTile
          className="col-span-1 row-span-1 aspect-square"
          tileTitle="Fun Items"
          href="/products"
          tileSize="small"
          onClick={() => (window.location.href = "/products")}
        />
        <BentoTile
          className="col-span-1 row-span-1 aspect-square"
          tileTitle="Other Items"
          href="/products"
          tileSize="small"
          onClick={() => (window.location.href = "/products")}
        />

        <!-- Bottom-left wide rectangle (row 3, cols 1-2) -->
        <BentoTile
          className="col-span-2 row-span-1"
          tileTitle="Leisure Items"
          href="/products"
          tileSize="small"
          onClick={() => (window.location.href = "/products")}
        />

        <!-- Bottom two squares in bottom-right block (row 3, cols 5-6) -->
        <BentoTile
          className="col-span-1 row-span-1 aspect-square"
          tileTitle="Something"
          href="/products"
          tileSize="small"
          onClick={() => (window.location.href = "/products")}
        />
        <BentoTile
          className="col-span-1 row-span-1 aspect-square"
          tileTitle="Full Catalog"
          href="/products"
          tileSize="small"
          onClick={() => (window.location.href = "/products")}
        />
      </div>
    </div>

    <!-- Testimonials / Previous Clients section -->

    <div
      class="w-full bg-zinc-100 mt-32 flex justify-center items-center pb-10"
    >
      <div class="w-full max-w-6xl flex flex-col justify-center items-center">
        <h3 class="text-4xl text-left text-black w-full mt-20">
          Elliott Promotional Products is located in the London-Kitchener area,
          providing quality promotional merchandise for 28 years.
        </h3>
        <p class="text-sm text-black text-left w-full mt-6">
          Here are the types of businesses we've helped over the years...
        </p>

        <h2 class="text-5xl w-full text-left mt-6 font-bold">Clients</h2>
        <ClientSections client:load />
      </div>
    </div>

    <!-- Frequently asked questions section -->
    <div class="w-full my-20 flex justify-center items-center">
      <div class="w-full max-w-6xl flex flex-col justify-center items-center">
        <h2 class="text-5xl font-bold w-full text-left mb-6">
          Frequently Asked Questions
        </h2>
        <FAQSection client:load />
      </div>
    </div>

    <div
      class="w-full mt-20 flex flex-col justify-center items-center bg-black"
    >
      <p class="py-6 text-white text-md tracking-wide">
        Elliott Promotional Products • Stratford, ON •
        <a href="mailto:elliottpromotionalproducts@gmail.com" class="underline"
          >elliottpromotionalproducts@gmail.com</a
        >
      </p>
      <div
        class="w-full max-w-6xl flex flex-row justify-center items-center space-x-20"
      >
        <img
          src="/images/white-logo.png"
          alt="elliott promotional products"
          class="w-64"
        />
        <div
          class="flex flex-col justify-center items-start text-white space-y-4"
        >
          <h2 class="text-white font-bold text-xl py-2">Legal</h2>
          <a href="" class="hover:underline">Terms of use</a>
          <a href="" class="hover:underline">Privacy policy</a>
          <a href="" class="hover:underline">Cookie policy</a>
        </div>
        <div
          class="flex flex-col justify-center items-start text-white space-y-4"
        >
          <h2 class="text-white font-bold text-xl py-2">Support</h2>
          <a href="" class="hover:underline">Contact us</a>
          <a href="" class="hover:underline">Send an email</a>
          <a href="" class="hover:underline">Request a quote</a>
        </div>
      </div>
      <p class="text-white mt-6 mb-16">Copyright 2025 &copy;</p>
    </div>
  </div>
</Layout>
