---
import "../styles/global.css";
import React, { useState } from "react";
import Layout from "../layouts/Layout.astro";
import NavigationBar from "../components/NavigationBar";
import { QuoteForm } from "../components/QuoteForm";
---

<Layout>
  <NavigationBar client:load />

  <div class="w-full flex flex-col justify-start items-center min-h-screen">
    <div class="max-w-6xl mx-auto mt-10 md:mt-20 space-y-10 px-6 md:px-0">
      <!-- Hero -->
      <h1 class="text-3xl md:text-5xl text-black font-bold mb-4">Contact Us</h1>
      <p class="text-lg md:text-xl text-black leading-relaxed">
        We are currently building a system that will allow you to checkout with
        our products - in the mean time, please use the below form to get in
        touch with us and request an order.
      </p>

      <QuoteForm client:load />

      <div class="flex flex-col space-y-4 justify-center items-start mt-20">
        <p class="text-xl text-black">
          Want to get in touch without filling the form? Send us an email
          instead.
        </p>
        <a
          href="mailto:owner@elliottpromotional.ca"
          class="bg-red-800 hover:bg-red-700 rounded-md font-bold text-white px-12 py-4"
          >Email Us
        </a>
      </div>
    </div>
  </div>
  <div
    class="w-full mt-10 md:mt-20 flex flex-col justify-center items-center bg-black"
  >
    <div
      class="w-full px-4 md:px-0 md:w-auto py-6 text-white text-sm md:text-md tracking-wide flex flex-col justify-center md:flex-row space-y-1 md:space-y-0 items-start md:items-center md:space-x-2"
    >
      <p>Elliott Promotional Products</p>
      <p class="hidden md:block">•</p>
      <p>Stratford, ON</p>

      <p class="hidden md:block">•</p>
      <p>
        <a href="mailto:owner@elliottpromotional.ca" class="underline"
          >owner@elliottpromotional.ca</a
        >
      </p>
    </div>
    <div
      class="w-full max-w-6xl flex flex-col md:flex-row justify-center items-center md:space-x-20"
    >
      <img
        src="/images/white-logo.png"
        alt="elliott promotional products"
        class="w-48 md:w-64"
      />

      <div
        class="w-full flex flex-row justify-center items-center space-x-12 md:space-x-20"
      >
        <div
          class="flex flex-col justify-center items-start text-white space-y-1 md:space-y-4"
        >
          <h2 class="text-white font-bold text-lg md:text-xl md:py-2">Legal</h2>
          <a href="/terms-of-use" class="hover:underline">Terms of use</a>
          <a href="/privacy-policy" class="hover:underline">Privacy policy</a>
          <a href="/cookie-policy" class="hover:underline">Cookie policy</a>
        </div>
        <div
          class="flex flex-col justify-center items-start text-white space-y-1 md:space-y-4"
        >
          <h2 class="text-white font-bold text-lg md:text-xl md:py-2">
            Support
          </h2>
          <a href="/contact" class="hover:underline">Contact us</a>
          <a href="mailto:owner@elliottpromotional.ca" class="hover:underline"
            >Send an email</a
          >
          <a href="/contact" class="hover:underline">Request a quote</a>
        </div>
      </div>
    </div>
    <p class="text-white mt-6 mb-16">Copyright 2025 &copy;</p>
  </div>
</Layout>
