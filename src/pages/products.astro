---
import Collapser from "../components/Collapser.tsx";
import BentoTile from "../components/BentoTile";
import NavigationBar from "../components/NavigationBar";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import type React from "react";
import ProductCollapsers from "../components/ProductCollapsers";
import ActionButton from "../components/ActionButton";
import Footer from "../components/Footer";
---

<Layout>
  <NavigationBar client:load />

  <div class="w-full flex flex-col justify-center items-center">
    <div
      class="w-full max-w-6xl flex flex-col justify-center items-start space-y-8 mt-10 md:mt-20 px-6 md:px-0"
    >
      <h2 class="font-bold text-3xl md:text-5xl">Products</h2>
      <p class="text-lg md:text-2xl">
        We are currently building our database to provide you with a centralized
        location for all of our offerings. In the meantime, you can view our
        supplier catalogs below.
      </p>

      <ProductCollapsers client:load />

      <div class="flex flex-col space-x-4 space-y-4 mt-10">
        <p>
          We strive to provide a wide range of products to choose from. That
          being said, we are flexible in our offerings. If you'd like something
          else branded, please let us know.
        </p>
        <ActionButton
          text="Get in touch"
          onClick={() => (window.location.href = "/contact")}
        />
      </div>
    </div>
  </div>
  <Footer client:load />
</Layout>
