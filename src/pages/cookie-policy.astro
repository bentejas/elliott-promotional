---
import NavigationBar from "../components/NavigationBar";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Footer from "../components/Footer";
---

<Layout>
  <NavigationBar client:load />

  <div class="max-w-6xl mx-auto mt-20 px-6 md:px-0 space-y-8">
    <h1 class="text-3xl md:text-5xl font-bold">Cookie Policy</h1>

    <section class="space-y-4 text-gray-800">
      <p>
        We currently do not use cookies for tracking on this site. Should we
        introduce cookies in the future, this policy will be updated.
      </p>

      <h2 class="text-xl font-semibold">What Are Cookies?</h2>
      <p>
        Cookies are small text files stored on your device by your browser. They
        help websites remember your preferences.
      </p>

      <h2 class="text-xl font-semibold">Our Use of Cookies</h2>
      <p>
        At this time, Elliott Promotional Products does not place any cookies.
        If we start using essential or analytics cookies, we will notify you and
        provide opt-out instructions here.
      </p>

      <h2 class="text-xl font-semibold">Contact Us</h2>
      <p>
        Questions about our cookie practices? Email us at <a
          href="mailto:owner@elliottpromotional.ca"
          class="underline">owner@elliottpromotional.ca</a
        >.
      </p>
    </section>
  </div>

  <Footer client:load />
</Layout>
